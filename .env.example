OPENALEX_API_KEY=QeUane0ElnXGmkEjUMMc5D
ANTHROPIC_API_KEY=
NEO4J_PASSWORD=
CONTACT_EMAIL=Immo.Primus@gmx.de

# ---- LLM Provider (set EXACTLY ONE block; leave the rest blank) ----
# Provider registry key (must match a registered adapter; see
# src/providers/registry.py). Ollama is the one production adapter
# shipping with #19.
LLM_PROVIDER=ollama
# Provider-specific model identifier. Mandatory for the selected adapter.
LLM_MODEL=
# Ollama (local; no key needed):
OLLAMA_BASE_URL=http://localhost:11434
# Anthropic:
ANTHROPIC_API_KEY=
# OpenAI:
OPENAI_API_KEY=

# Optional LLM settings (spec §3.2).
LLM_BUDGET_USD=
LLM_BUDGET_TOKENS=
LLM_CACHE_DIR=data/derived/llm_cache/
LLM_PROVIDER_TIMEOUT_S=60

# ---- Embedding Provider ----
# Provider registry key for the EmbeddingProvider adapter.
EMBEDDING_PROVIDER=local_sentence_transformers
# Hugging Face model id; the adapter pins the revision in code
# (vector-retrieval.md §1.1; #19 ticket — do not override the revision
# via env, the constant is hard-coded to prevent silent drift).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional embedding settings.
EMBEDDING_BATCH_SIZE=64
