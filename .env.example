# Template for the local .env file. Copy to .env (gitignored) and fill
# in real values locally. This file MUST contain only blank credential
# and contact placeholders — no literal API keys, no passwords, and no
# personal contact values (issue #18 acceptance gate, local-infra.md §5).
#
# Required values per local-infra.md §5.1 and implementation-spec.md §3.

# ---- Credentials (blank — fill .env locally) -----------------------
OPENALEX_API_KEY=
CONTACT_EMAIL=

# ---- Local infrastructure (issue #18, local-infra.md §5.1) ----------
# Credentials for the Docker Compose stack in docker-compose.yml at
# the repo root. Real values live only in .env; compose references
# them via ${VAR}.
NEO4J_PASSWORD=
# Optional app-side Neo4j defaults; Compose uses the same default user.
NEO4J_USER=neo4j
NEO4J_URI=bolt://localhost:7687
PGVECTOR_USER=
PGVECTOR_PASSWORD=
PGVECTOR_DB=rag
# App-side reachability defaults for Python drivers. Not secrets.
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5433

# ---- LLM Provider (set EXACTLY ONE block; leave the rest blank) ----
# Provider registry key (must match a registered adapter; see
# src/providers/registry.py). Ollama is the one production adapter
# shipping with #19.
LLM_PROVIDER=ollama
# Provider-specific model identifier. Mandatory for the selected adapter.
LLM_MODEL=
# Ollama (local; no key needed):
OLLAMA_BASE_URL=http://localhost:11434
# Anthropic:
ANTHROPIC_API_KEY=
# OpenAI:
OPENAI_API_KEY=

# Optional LLM settings (spec §3.2).
LLM_BUDGET_USD=
LLM_BUDGET_TOKENS=
LLM_CACHE_DIR=data/derived/llm_cache/
LLM_PROVIDER_TIMEOUT_S=60

# ---- Embedding Provider ----
# Provider registry key for the EmbeddingProvider adapter.
EMBEDDING_PROVIDER=local_sentence_transformers
# Hugging Face model id; the adapter pins the revision in code
# (vector-retrieval.md §1.1; #19 ticket — do not override the revision
# via env, the constant is hard-coded to prevent silent drift).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional embedding settings.
EMBEDDING_BATCH_SIZE=64
